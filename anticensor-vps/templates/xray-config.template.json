{
  "_README": "Fill {{PLACEHOLDERS}} then save to /usr/local/etc/xray/config.json. Generate: UUID=`xray uuid`; PQ_DECRYPTION via `xray vlessenc` (server side, keeps 600s token); REALITY_PRIVKEY via `xray x25519` (use the Private; client gets the Public as pbk); SHORT_ID=`openssl rand -hex 8`; HY2_AUTH/SALAMANDER_PW = random strings. Ports: random high (NOT 443/8443). Delete this _README key before use (JSON has no comments).",
  "log": {
    "loglevel": "warning",
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log"
  },
  "inbounds": [
    {
      "tag": "vless-xhttp-reality-pq",
      "listen": "0.0.0.0",
      "port": {{XHTTP_PORT}},
      "protocol": "vless",
      "settings": {
        "clients": [ { "id": "{{UUID}}" } ],
        "decryption": "mlkem768x25519plus.native.600s.{{PQ_SEED}}"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": { "host": "{{REALITY_SNI}}", "path": "/{{XHTTP_PATH}}", "mode": "auto" },
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{REALITY_DEST}}:443",
          "xver": 0,
          "serverNames": [ "{{REALITY_SNI}}" ],
          "privateKey": "{{REALITY_PRIVKEY}}",
          "shortIds": [ "{{SHORT_ID}}" ]
        }
      },
      "sniffing": { "enabled": true, "destOverride": [ "http", "tls", "quic" ] }
    },
    {
      "tag": "hysteria2-salamander",
      "listen": "0.0.0.0",
      "port": {{HY2_PORT}},
      "protocol": "hysteria",
      "settings": { "version": 2, "clients": [ { "auth": "{{HY2_AUTH}}" } ] },
      "streamSettings": {
        "network": "hysteria",
        "hysteriaSettings": { "version": 2 },
        "security": "tls",
        "tlsSettings": {
          "alpn": [ "h3" ],
          "certificates": [ { "certificateFile": "/usr/local/etc/xray/certs/hy2.crt", "keyFile": "/usr/local/etc/xray/certs/hy2.key" } ]
        },
        "finalmask": { "udp": [ { "type": "salamander", "settings": { "password": "{{SALAMANDER_PW}}" } } ] }
      },
      "sniffing": { "enabled": true, "destOverride": [ "http", "tls", "quic" ] }
    }
  ],
  "outbounds": [
    { "tag": "direct", "protocol": "freedom" },
    { "tag": "block", "protocol": "blackhole" }
  ]
}
